# Edge service network and persistence
EDGE_HOST=127.0.0.1
EDGE_PORT=3001
# EDGE_DATABASE_PATH=./apps/edge-server/data/smart-kiosk.sqlite
KIOSK_ORIGIN=http://localhost:5173

# Required in production for /v1/staff/* operations. In development only, the
# staff console accepts dev-staff-token when this is omitted.
STAFF_ACCESS_TOKEN=replace-with-a-long-random-token

# Pricing configuration. Values are in basis points (825 = 8.25%).
TAX_RATE_BPS=0
# Example: [{"code":"WELCOME10","type":"PERCENT_BPS","value":1000}]
KIOSK_PROMOTIONS_JSON=[]
