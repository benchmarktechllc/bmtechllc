ANTHROPIC_API_KEY=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DATABASE_URL=
# Required. Private channel for Approve/Deny messages; the app refuses to start if the bot
# can't fetch it. Only members with APPROVER_ROLE_ID can decide. Changing either needs a restart.
APPROVER_CHANNEL_ID=
APPROVER_ROLE_ID=
# Optional, default 24h. Formats: 24h, 5m, 90s, 300 (seconds). Use a few minutes locally.
APPROVAL_TTL=
TEST_DATABASE_URL=
